# Copy to .env and fill in.

# ---------------------------------------------------------------------------
# Postgres (Supabase)
# ---------------------------------------------------------------------------
# DATABASE_URL — used by the running app.
#   Local:      the Supabase CLI stack (`pnpm db:up`).
#   Production: Supabase → Connect → Transaction pooler (port 6543).
#               db/index.ts turns off prepared statements on that port.
#   On Vercel with the Supabase integration connected, POSTGRES_URL is injected
#   and used automatically — leave DATABASE_URL unset there.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# DIRECT_URL — used by drizzle-kit only, because migrations run DDL and the
# transaction pooler does not support it.
#   Local:      same as DATABASE_URL.
#   Production: Supabase → Connect → Session pooler / direct connection (5432).
#   On Vercel, POSTGRES_URL_NON_POOLING is injected and used automatically.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# ---------------------------------------------------------------------------
# Supabase Auth — the identity provider. Staff sign in with email + password.
# ---------------------------------------------------------------------------
# Local values come from `supabase status` after `pnpm db:up`. The local keys
# are identical for every Supabase CLI project on every machine, so they are
# not secrets. In production use the project's own URL and keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Service-role key: creates, updates and deletes staff accounts via the Admin
# API. It bypasses every access check, so it must never reach the browser —
# note the deliberate absence of a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Public base URL of the deployed app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

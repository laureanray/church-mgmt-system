# copies, so it has to be tracked.
!.env.example

# leftover SQLite database from the pre-Supabase (libSQL/Turso) setup
/local.db
/local.db-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/playwright-report/
/test-results/
